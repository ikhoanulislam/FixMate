{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/booking/[id]",
      "regex": "^/booking/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/booking/(?<nxtPid>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/booking/[id].segments/booking/$d$id$segment",
          "source": "^/booking/(?<nxtPid>[^/]+?)\\.segments/booking/\\$d\\$id(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPid": "nxtPid"
          }
        }
      ]
    },
    {
      "page": "/services/[id]",
      "regex": "^/services/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/services/(?<nxtPid>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/services/[id].segments/services/$d$id$segment",
          "source": "^/services/(?<nxtPid>[^/]+?)\\.segments/services/\\$d\\$id(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPid": "nxtPid"
          }
        }
      ]
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/admin",
      "regex": "^/dashboard/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/admin(?:/)?$"
    },
    {
      "page": "/dashboard/customer",
      "regex": "^/dashboard/customer(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/customer(?:/)?$"
    },
    {
      "page": "/dashboard/customer/bookings",
      "regex": "^/dashboard/customer/bookings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/customer/bookings(?:/)?$"
    },
    {
      "page": "/dashboard/customer/payments",
      "regex": "^/dashboard/customer/payments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/customer/payments(?:/)?$"
    },
    {
      "page": "/dashboard/technician",
      "regex": "^/dashboard/technician(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/technician(?:/)?$"
    },
    {
      "page": "/dashboard/technician/requests",
      "regex": "^/dashboard/technician/requests(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/technician/requests(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/payment/cancel",
      "regex": "^/payment/cancel(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/payment/cancel(?:/)?$"
    },
    {
      "page": "/payment/success",
      "regex": "^/payment/success(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/payment/success(?:/)?$"
    },
    {
      "page": "/services",
      "regex": "^/services(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services(?:/)?$"
    },
    {
      "page": "/sign-in",
      "regex": "^/sign\\-in(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sign\\-in(?:/)?$"
    },
    {
      "page": "/sign-up",
      "regex": "^/sign\\-up(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sign\\-up(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": true,
    "dynamicRSCPrerender": true
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "ppr": {
    "chain": {
      "headers": {
        "next-resume": "1"
      }
    }
  }
}